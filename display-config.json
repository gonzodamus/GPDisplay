{
  "layout": {
    "columns": [
      {
        "width": "38%",
        "direction": "column",
        "paddingTop": "30px",
        "paddingLeft": "30px",
        "items": [
          { "type": "text", "oscAddress": "/CurrentSongName", "label": "Song", "fontSize": "5.5rem" },
          { "type": "text", "oscAddress": "/SelectedSongPartName", "label": "Part", "fontSize": "3.5rem", "hideIfValue": "Song" },
          { "type": "text", "oscAddress": "/GlobalRackspace/SetlistNameName", "label": "Setlist", "fontSize": "2.5rem", "pushToBottom": true }
        ]
      },
      {
        "width": "10%",
        "direction": "column",
        "items": [
          { "type": "fader", "oscAddress": "/GlobalRackspace/k1vol/SetValue", "label": "K1", "color": "#4a7ab5" },
          { "type": "text", "oscAddress": "/Keys1LocalLabel", "fontSize": "1.2rem" }
        ]
      },
      {
        "width": "10%",
        "direction": "column",
        "items": [
          { "type": "fader", "oscAddress": "/GlobalRackspace/k2vol/SetValue", "label": "K2", "color": "#9b3030" },
          { "type": "text", "oscAddress": "/Keys2LocalLabel", "fontSize": "1.2rem" }
        ]
      },
      {
        "width": "10%",
        "direction": "column",
        "items": [
          { "type": "fader", "oscAddress": "/GlobalRackspace/mainvol/SetValue", "label": "Main", "color": "#6a6a6a" },
          { "type": "text", "staticValue": "Main", "fontSize": "1.2rem" }
        ]
      },
      {
        "width": "32%",
        "direction": "column",
        "paddingTop": "30px",
        "items": [
          {
            "type": "button",
            "oscAddress": "/GlobalRackspace/ohshit/SetValue",
            "label": "Oh Shit",
            "note": "Oh shit button",
            "color": "#cc2222"
          }
        ]
      }
    ]
  },
  "theme": {
    "background": "#626262",
    "foreground": "#e8e8e8",
    "accent": "#ff4444"
  }
}
