<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gpdisplay.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/scripts/server-start.sh</string>
  </array>

  <!-- Restart automatically if the server crashes -->
  <key>KeepAlive</key>
  <true/>

  <!-- Start at login -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/server.log</string>
</dict>
</plist>
