# Bridge listens on this UDP port for incoming OSC from Gig Performer.
# Must match "Remote client port" in GP's OSC Setup.
GP_OSC_SEND_PORT=8000

# GP listens on this UDP port. Bridge sends /Refresh here on client connect.
# Must match "GP's listening port" in GP's OSC Setup.
GP_OSC_LISTEN_PORT=54344

# HTTP + WebSocket server port. Open http://localhost:HTTP_PORT in Chrome.
HTTP_PORT=3000
